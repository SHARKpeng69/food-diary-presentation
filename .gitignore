# Keep the upload limited to the complete website and its rebuild sources.
/*
!/.gitignore
!/README.md
!/package.json
!/package-lock.json
!/wrangler.jsonc
!/outputs/
!/work/

/outputs/*
!/outputs/index.html
!/outputs/home-model.js
!/outputs/references-paper.js
!/outputs/paper-geometry.js
!/outputs/references-bibliography.md
!/outputs/references-data.json
!/outputs/gallery-extra-manifest.json
!/outputs/.assetsignore
!/outputs/vendor/
!/outputs/assets/
/outputs/assets/*
!/outputs/assets/images/
!/outputs/assets/home-pad-kra-pao-optimized.glb
# Obsolete DESCRIPTION image; the original source and six current layers are kept.
/outputs/assets/images/description/exploded-reference.png

/work/*
!/work/index.template.html
!/work/build_prototype.py
!/work/build_gallery_thumbnails.py
!/work/build_gallery_extras.py
!/work/home-model.js
!/work/references-paper.js
!/work/paper-geometry.js
!/work/references.json
!/work/gallery-extra-manifest.json
!/work/verify_paper.mjs
!/work/verify_gallery_assignment.mjs
!/work/optimize_home_model.mjs
!/work/verify_deployment.py
!/work/gallery-sources/
!/work/gallery-extra-sources/
!/work/reference/
/work/reference/*
!/work/reference/font-manifest.json
!/work/reference/*.woff2
!/work/reference/*-license.txt
!/work/reference/eye-original.mp4
!/work/reference/eye-frame-0.jpg

# Never include credentials, editor state, caches or local server logs.
**/.DS_Store
**/.env
**/.env.*
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/.npmrc
**/.netrc
**/.aws/
**/.ssh/
**/credentials.json
**/node_modules/
**/__pycache__/
**/*.pyc
**/*.log
